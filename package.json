{
  "name": "terminal-driver-mcp",
  "version": "0.6.1",
  "description": "A real interactive terminal for AI agents (MCP). Run and test vim, htop, gdb, REPLs, and any TUI — things the built-in fire-and-forget terminal can't touch.",
  "type": "module",
  "license": "MIT",
  "author": "funkyfunc",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "terminal",
    "pty",
    "pseudo-terminal",
    "tui",
    "tui-testing",
    "node-pty",
    "xterm",
    "headless-terminal",
    "ai-agents",
    "agent-tools",
    "claude",
    "llm",
    "vim",
    "repl",
    "automation",
    "e2e-testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funkyfunc/terminal-driver-mcp.git"
  },
  "homepage": "https://github.com/funkyfunc/terminal-driver-mcp#readme",
  "bugs": {
    "url": "https://github.com/funkyfunc/terminal-driver-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "terminal-driver-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "node -e \"try{const fs=require('fs'),p=require('path').join(require('path').dirname(require.resolve('node-pty/package.json')),'prebuilds');for(const d of fs.readdirSync(p)){try{fs.chmodSync(require('path').join(p,d,'spawn-helper'),0o755)}catch{}}}catch{}\"",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node test/unit-keys.mjs && node test/unit-mouse.mjs && node test/unit-render.mjs && node test/unit-screen.mjs && node test/unit-shell.mjs && node test/unit-skeleton.mjs && node test/e2e.mjs && node test/gauntlet.mjs",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@resvg/resvg-js": "^2.6.2",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
